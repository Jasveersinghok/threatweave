# === Required — choose one LLM backend ===

# --- Option A: Groq Cloud (free tier, rate-limited) ---
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Option B: Local model via vLLM + ngrok (recommended, no rate limits) ---
# LLM_MODEL=openai/Qwen/Qwen2.5-32B-Instruct-AWQ
# LLM_FALLBACK_MODEL=openai/Qwen/Qwen2.5-32B-Instruct-AWQ
# OPENAI_API_BASE=https://your-ngrok-url.ngrok-free.app/v1
# OPENAI_API_KEY=your_vllm_api_key_here

# --- Option C: Ollama (local, easiest setup) ---
# LLM_MODEL=ollama/llama3.1:8b
# LLM_FALLBACK_MODEL=ollama/llama3.1:8b

# === Active Model Selection ===
LLM_MODEL=groq/openai/gpt-oss-120b
LLM_FALLBACK_MODEL=groq/openai/gpt-oss-20b

# === Embedding Model ===
EMBEDDING_MODEL=all-MiniLM-L6-v2

# === Qdrant Configuration ===
# Mode: "memory" (default, no persistence) or "persistent" (stores to disk)
QDRANT_MODE=persistent
# Path for persistent storage (only used when QDRANT_MODE=persistent)
QDRANT_PATH=./data/qdrant

# === Optional — enhances enrichment quality ===

# NVD API key (free at https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=your_nvd_api_key_here

# AlienVault OTX API key (free at https://otx.alienvault.com)
OTX_API_KEY=your_otx_api_key_here

# MaxMind GeoLite2 license key (free at https://www.maxmind.com/en/geolite2/signup)
MAXMIND_LICENSE_KEY=your_maxmind_license_key_here
